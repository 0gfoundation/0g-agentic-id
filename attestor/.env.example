# ── Chain ────────────────────────────────────────────────────────
ATTESTOR_CHAIN_RPC=https://evmrpc-testnet.0g.ai
ATTESTOR_CHAIN_ID=16602
ATTESTOR_AGENTIC_ID_ADDR=0x5BB50987521A3fb7Da6Cd6aCC0ad1061D975B24A
ATTESTOR_TAPP_REGISTRY_ADDR=0x0000000000000000000000000000000000000000
# Canonical ERC-8004 IdentityRegistry. Auto-derived from ATTESTOR_CHAIN_ID
# (0G/Eth mainnet 0x8004A169…, 0G Galileo/Eth Sepolia 0x8004A818…); set only to
# override for a local/anvil chain or a network not in the built-in map.
# ATTESTOR_CANONICAL_8004_ADDR=0x8004A818BFB912233c491871b3d84c89A494BD9e

# ── TEE key (dev mock) ───────────────────────────────────────────
# In production the attestor's EOA key is fetched from the tapp runtime
# inside the TEE (gRPC GetAppSecretKey). For local dev set MOCK_TEE=true
# and provide BOTH the hex priv key AND its matching 20-byte address —
# env schema mirrors 0g-sandbox/tapp so deploy configs stay interchangeable.
# The mock validates the pair at startup (address must be derived from
# the priv key) to catch copy-paste mistakes.
# The address must also be added to AgenticID.trustedAttestors on-chain.
# Example (anvil account #0):
#   MOCK_APP_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
#   MOCK_APP_ETH_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cfFFb92266
MOCK_TEE=true
MOCK_APP_PRIVATE_KEY=
MOCK_APP_ETH_ADDRESS=

# ── KMS (app-scoped master secret) ───────────────────────────────
# MOCK_KMS=true: all three binaries use MockKmsClient and MUST set
# MOCK_APP_SECRET=0x<64 hex> (32-byte app secret). All three services
# must read the same value or their derived subkeys diverge.
# MOCK_KMS=false: use TappKmsClient over gRPC to tapp-server.
MOCK_KMS=true
MOCK_APP_SECRET=0x0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20

# ── tapp-server gRPC (TEE EOA key + KMS secret) ──────────────────
# tapp-server runs on the Docker HOST and exposes a local gRPC service:
#   - GetAppSecretKey(app_id, key_type="ethereum")  → the attestor's EOA
#   - GetSecretResource(app_id)                     → 32B KMS app secret
# tapp internally handles KMS auth/decryption; the plaintext key comes
# back over the local socket.
#
# Inside docker compose, `host.docker.internal` resolves to the host via
# `extra_hosts: host.docker.internal:host-gateway` (already wired in
# compose for the services that need it).
ATTESTOR_TAPP_IP=host.docker.internal
ATTESTOR_TAPP_PORT=50051
# app_id registered on-chain in TappRegistry; shared by both RPCs.
# Required when MOCK_TEE=false or MOCK_KMS=false. Also surfaced to the
# deploy UI as the "attestor" slot in the trust-roots ack modal.
ATTESTOR_APP_ID=

# ── Trust-roots ack (TappRegistry + SandboxServing) ──────────────
# Before a user can deploy, the UI asks them to acknowledge three Tapp
# apps on TappRegistry: attestor itself (ATTESTOR_APP_ID above), the
# KMS attestor derives keys from, and the sandbox provider that runs
# agent containers. One batch tx (TappRegistry.acknowledgeApps) acks
# whichever are missing.
#
# The sandbox slot also pulls per-provider business state (URL,
# pricing) from SandboxServing (separate contract from TappRegistry).
#
# Any value left blank disables the corresponding ack slot — useful
# for local mock setups; production must set all four.
ATTESTOR_KMS_APP_ID=
ATTESTOR_SANDBOX_APP_ID=
# Provider EOA registered in SandboxServing — populate after the sandbox
# provider has called SandboxServing.addOrUpdateService for their address.
ATTESTOR_SANDBOX_PROVIDER_ADDR=
# SandboxServing contract deployment address — fill in after the
# SandboxServing proxy is deployed on this chain.
ATTESTOR_SANDBOX_SERVING_ADDR=
# Sandbox snapshot the attestor instantiates new agent containers from
# (passed as the `snapshot` field in the sandbox create envelope). Bump
# to point new deploys at a newer sealed-runtime image; legacy default
# below if unset.
ATTESTOR_SANDBOX_SNAPSHOT=0g-test-sealed

# Public-port allowlist (0g-sandbox#57), comma-separated. When set, every
# sandbox create carries `publicPorts` so ONLY these ports are publicly
# reachable via the preview proxy; all others (SSH 22222, toolbox 2280, any
# stray container port) fall back to Daytona auth. Sealed agents serve on
# ATTESTOR_AGENT_SERVE_PORT (8080), so it MUST be listed. Leave EMPTY for the
# default all-ports-public behavior — that is also the only safe setting until
# the sandbox provider runs the 0g-daytona fork images (stock Daytona 502s an
# unknown field). Turn on (e.g. `8080`) only after the provider is upgraded.
ATTESTOR_SANDBOX_PUBLIC_PORTS=

# Framework names deploys may select, comma-separated — the attestor's ONLY
# framework knowledge (opaque strings: checked pre-mint at the deploy edge,
# served by GET /config for the UI picker). MUST match the adapters the sealed
# image in ATTESTOR_SANDBOX_SNAPSHOT actually bundles — a name sealed doesn't
# register mints an agent whose container can't resolve an adapter. Unset (or
# effectively empty) = the default `openclaw`. Bump together with the sealed
# image when a new framework ships.
# ATTESTOR_SUPPORTED_FRAMEWORKS=openclaw

# ── Storage ──────────────────────────────────────────────────────
ATTESTOR_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
# MOCK_STORAGE=true: worker uses MockStorage (keccak256 stand-in for the
# merkle root, no upload). MOCK_STORAGE=false: worker uses ZgStorage via
# the upstream Rust SDK to upload to ATTESTOR_STORAGE_INDEXER. Real mode
# requires the attestor's TEE EOA to have 0G testnet gas (storage upload
# also submits an on-chain flow tx).
MOCK_STORAGE=true

# ── Sandbox ──────────────────────────────────────────────────────
# Real deployment: http://47.236.111.154:8082
# Local dev: http://localhost:9100 (or wherever you run 0g-sandbox)
ATTESTOR_SANDBOX_ENDPOINT=http://localhost:9100
# When true, worker uses MockSandbox (logs only, no HTTP). Set to false to
# actually relay user-signed envelopes to ATTESTOR_SANDBOX_ENDPOINT.
MOCK_SANDBOX=true
# Public URL of THIS attestor, injected into the sandbox container as
# env.ATTESTOR_URL so the container knows where to POST /provision and
# /status. Must be reachable from the sandbox host — localhost works only
# if sandbox runs on the same box. For the hosted sandbox, use a public
# hostname (ngrok / reverse proxy / actual deployment URL).
# Ignored when MOCK_SANDBOX=true.
ATTESTOR_PUBLIC_URL=http://localhost:8080
# ── Database ─────────────────────────────────────────────────────
ATTESTOR_DB_URL=postgres://attestor:attestor@localhost:5432/attestor

# ── Server ───────────────────────────────────────────────────────
ATTESTOR_BIND=0.0.0.0:8080

# ── Job queue ────────────────────────────────────────────────────
# Retention for completed/failed jobs (seconds). Worker sweeps periodically.
ATTESTOR_JOB_RETENTION_SECONDS=3600

# ── Chain gas (EIP-1559) ─────────────────────────────────────────
# Priority fee (tip, gwei). 0G testnet minimum is 2.
ATTESTOR_PRIORITY_FEE_GWEI=2
# Max fee per gas (gwei) upper bound.
ATTESTOR_MAX_FEE_GWEI=10

# ── Indexer ──────────────────────────────────────────────────────
# Block number to scan from when no checkpoint exists (typically the
# AgenticID contract deployment block). Unset → latest-128 (quick start).
# ATTESTOR_INDEXER_START_BLOCK=

# ── Off-chain storage (Ali OSS) ──────────────────────────────────
# AgentCard JSON and images are PUT here as public objects; the resulting
# URL is written into on-chain tokenURI via setAgentURI. Leave blank to
# disable (deploy will fail until wired up). For 0xf952... bucket the JS
# web app also uses, set OSS_BUCKET=dev-agent-market.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=dev-agent-market
OSS_REGION=oss-cn-beijing
# Overrides — usually leave blank:
# OSS_ENDPOINT_HOST=oss-cn-beijing.aliyuncs.com
# OSS_PUBLIC_URL_BASE=https://dev-agent-market.oss-cn-beijing.aliyuncs.com
# Key prefix; default is "0x<ATTESTOR_AGENTIC_ID_ADDR>" to namespace by
# contract so a shared bucket doesn't collide across deployments.
# OSS_KEY_PREFIX=

# ── Agent runtime endpoints ──────────────────────────────────────
# Each agent container exposes two URLs via the sandbox proxy:
#   http://{port}-{sandbox_id}.{sandbox_proxy_addr}{path}
# - Serve:     public service entry (written on chain via tokenURI as
#              AgentCard.url). Renamed from "A2A" to avoid overloading
#              the ERC-8004 term — in 8004 "A2A" refers to the AgentCard
#              itself, not the runtime endpoint.
# - Dashboard: owner-only operator view (used by deploy console)
# In most setups the two share a port and only paths differ.
ATTESTOR_SANDBOX_PROXY_ADDR=47.236.111.154.nip.io:4000
ATTESTOR_AGENT_SERVE_PORT=8080
ATTESTOR_AGENT_SERVE_PATH=/hello
ATTESTOR_AGENT_DASHBOARD_PORT=8080
ATTESTOR_AGENT_DASHBOARD_PATH=/dashboard

# ── Logging ──────────────────────────────────────────────────────
RUST_LOG=info,attestor_api=debug,attestor_worker=debug,attestor_indexer=debug
