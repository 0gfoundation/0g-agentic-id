{
  "name": "@0gfoundation/0g-agentdna",
  "version": "0.2.1",
  "description": "0G AgentDNA TypeScript SDK and CLI for on-chain AI agent identities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "0g-agentdna": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./seal": {
      "types": "./dist/seal.d.ts",
      "default": "./dist/seal.js"
    },
    "./cli": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "GUIDE.md",
    "LICENSE",
    "MIGRATION.md",
    "MIGRATION.zh.md",
    "PROVIDERS.md",
    "PROVIDERS.zh.md",
    "scripts/sync-providers.cjs"
  ],
  "scripts": {
    "build": "node scripts/sync-providers.cjs && tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:kav": "npm run build && node scripts/serveproof-kav.cjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "0g",
    "agentdna",
    "agent",
    "identity",
    "tee",
    "blockchain",
    "ethereum",
    "viem"
  ],
  "license": "MIT",
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0gfoundation/0g-agentic-id.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/0gfoundation/0g-agentic-id/tree/main/sdk/typescript#readme",
  "bugs": {
    "url": "https://github.com/0gfoundation/0g-agentic-id/issues"
  }
}
